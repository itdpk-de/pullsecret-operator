## Location to install dependencies to
LOCALBIN ?= $(shell pwd)/bin
$(LOCALBIN):
	mkdir -p $(LOCALBIN)

# Tool binaries
CONTROLLER_GEN ?= $(LOCALBIN)/controller-gen

# Tool versions
CONTROLLER_TOOLS_VERSION ?= v0.20.0
CRD_DIR ?= pullsecret/templates
HELM_CRD_DIR ?= helm-chart/pullsecret-operator/templates

.PHONY: manifests
manifests: controller-gen
	$(CONTROLLER_GEN) \
		crd:crdVersions=v1 \
		paths="./pkg/apis/pullsecret.itdpk.de/..." \
		output:crd:artifacts:config=$(CRD_DIR)
	# Copy generated CRD to Helm chart templates with warning header, gated by installCRDs
	@echo "# WARNING: This file is AUTO-GENERATED by 'make manifests'. Do not edit manually!" > $(HELM_CRD_DIR)/crd.yaml
	@echo "# To update this CRD, modify pkg/apis/pullsecret.itdpk.de/v1/clusterpullsecret_types.go" >> $(HELM_CRD_DIR)/crd.yaml
	@echo "# and run 'make manifests' from the repository root." >> $(HELM_CRD_DIR)/crd.yaml
	@echo '{{- if .Values.installCRDs }}' >> $(HELM_CRD_DIR)/crd.yaml
	@cat $(CRD_DIR)/pullsecret.itdpk.de_clusterpullsecrets.yaml >> $(HELM_CRD_DIR)/crd.yaml
	@echo '{{- end }}' >> $(HELM_CRD_DIR)/crd.yaml

.PHONY: generate
generate: controller-gen
	$(CONTROLLER_GEN) object paths="./pkg/apis/pullsecret.itdpk.de/v1"

.PHONY: controller-gen
controller-gen: $(CONTROLLER_GEN)
$(CONTROLLER_GEN): $(LOCALBIN)
	test -s $(LOCALBIN)/controller-gen && $(LOCALBIN)/controller-gen --version | grep -q $(CONTROLLER_TOOLS_VERSION) || \
	GOBIN=$(LOCALBIN) go install sigs.k8s.io/controller-tools/cmd/controller-gen@$(CONTROLLER_TOOLS_VERSION)

# Docker image configuration
REGISTRY ?= ghcr.io
IMAGE_REPO ?= itdpk-de/pullsecret-operator
IMAGE_TAG ?= latest
# Remove all leading hyphens from IMAGE_TAG and default to 'latest' if empty
IMAGE_TAG_CLEAN = $(shell echo "$(IMAGE_TAG)" | sed 's/^-*//' | sed 's/^$$/latest/')
IMAGE_NAME = $(REGISTRY)/$(IMAGE_REPO):$(IMAGE_TAG_CLEAN)

.PHONY: docker-build
docker-build:
	docker buildx build --load -t $(IMAGE_NAME) .

.PHONY: docker-push
docker-push:
	docker push $(IMAGE_NAME)

.PHONY: build-push
build-push:
	docker buildx build --push -t $(IMAGE_NAME) .

# End-to-end test on a real (kind) cluster: build+load image, install the chart with
# the webhook enabled, and verify secret creation, webhook injection, status and cleanup.
.PHONY: test-e2e
test-e2e:
	./test/e2e/e2e.sh